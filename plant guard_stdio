function renderAIResult(){if($('#aiResult'))$('#aiResult').innerHTML=(aiResult.gate?gateHTML(aiResult.gate):'')+aiSummaryHTML(aiResult)+`<div class="card-actions"><button onclick="setPage('care')">Control & prevention</button><button onclick="setPage('device')">View device workflow</button></div><div class="notice">Model suggestions need confirmation. Photo screening reduces unsuitable inputs but is not a guaranteed leaf detector. Do not use this for edibility decisions.</div>`}
function validAI(a){return a==null||(a.version===1&&['plantModel','diseaseModel','scope','time'].every(k=>typeof a[k]==='string')&&['inferenceMs','totalMs'].every(k=>Number.isFinite(a[k])&&a[k]>=0)&&['plants','diseases'].every(k=>Array.isArray(a[k])&&a[k].length===3&&a[k].every(x=>typeof x.label==='string'&&Number.isFinite(x.score)&&x.score>=0&&x.score<=1))&&a.decision&&['state','title','message'].every(k=>typeof a.decision[k]==='string'))}
async function prepareOffline(){const b=$('#offlineReady');if(b)b.disabled=true;try{if(!('serviceWorker'in navigator))throw Error('Offline caching is unavailable. Use the downloaded package with its local launcher.');if(b)b.textContent='Saving app + models…';const reg=await navigator.serviceWorker.register('sw.js');await navigator.serviceWorker.ready;const worker=reg.active||reg.waiting||reg.installing;const ch=new MessageChannel();await new Promise((resolve,reject)=>{const timer=setTimeout(()=>reject(Error('Offline preparation timed out. Keep this page open and try again.')),180000);ch.port1.onmessage=e=>{if(e.data.ok){clearTimeout(timer);resolve()}else if(e.data.error){clearTimeout(timer);reject(Error(e.data.error))}else if(b)b.textContent=`Saving ${e.data.done} / ${e.data.total} files…`};worker.postMessage({type:'CACHE_ALL'},[ch.port2])});if(b)b.textContent='Offline files saved ✓';toast('App and model files saved. Reload this same address with Wi-Fi off to verify on your device.')}catch(e){if(b){b.disabled=false;b.textContent='Prepare offline mode'}toast(e.message)}}
